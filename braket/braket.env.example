# Copy to an untracked local file and load it with --env-file.
# Never commit AWS credentials; rely on the normal AWS credential chain.
BRAKET_BACKEND=local
BRAKET_QPU_ARN=
BRAKET_ROLE_ARN=
BRAKET_S3_OUTPUT=
BRAKET_INSTANCE_TYPE=ml.m5.large
BRAKET_VOLUME_GB=30
BRAKET_MAX_RUNTIME_SECONDS=3600
BRAKET_JOB_NAME=
